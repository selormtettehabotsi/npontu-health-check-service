# Copy this file to .env and fill in your values:
#   cp .env.example .env

PORT=3000

# Per-check timeout in milliseconds. Should be shorter than the timeout of
# whatever is polling /health, or the poller gives up before this replies.
TIMEOUT_MS=3000

# The three endpoints to monitor. If these are unset the service falls back to
# the local mocks in mock.js, so it still runs out of the box.
SERVICE_1_NAME=auth-service
SERVICE_1_URL=http://localhost:9001/status

SERVICE_2_NAME=payments-service
SERVICE_2_URL=http://localhost:9002/status

SERVICE_3_NAME=catalog-service
SERVICE_3_URL=http://localhost:9003/status
